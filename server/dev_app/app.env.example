NODE_ENV=development
ENPRA_DATA_DIR=/data
ENPRA_CORS_ORIGIN=http://localhost:3000

# Use the same Postgres container as production, but a different database.
DATABASE_URL=postgresql://enpra:replace-with-a-db-password@db:5432/enpra_dev

# Keep development OAuth credentials and the service token separate from production.
ENPRA_BRIDGE_SERVICE_TOKEN=replace-with-a-separate-long-random-secret
CONNECTION_ENCRYPTION_KEY=replace-with-a-separate-32-byte-base64-key
