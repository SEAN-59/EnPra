NODE_ENV=production
ENPRA_DATA_DIR=/data
ENPRA_CORS_ORIGIN=https://enpra-english-practice.sean-kr.chatgpt.site

# Generate a long random value on the server. Do not commit the real value.
ENPRA_SESSION_SECRET=replace-with-a-long-random-secret
ENPRA_BRIDGE_SERVICE_TOKEN=replace-with-a-separate-long-random-secret

# Comma-separated ChatGPT user IDs allowed to use /admin. The first administrator
# is configured here; later role changes are managed from the admin page.
ENPRA_ADMIN_USER_IDS=replace-with-your-chatgpt-user-id

# Used by the Postgres-backed bridge.
DATABASE_URL=postgresql://enpra:replace-with-a-db-password@db:5432/enpra
CONNECTION_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
