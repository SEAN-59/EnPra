# Copy this file to .env on the server's docker/EnPra folder.
ENPRA_RELEASE_IMAGE=ghcr.io/sean-59/enpra-bridge:latest
ENPRA_APP_CONTAINER_NAME=enpra-bridge
ENPRA_DEV_IMAGE=ghcr.io/sean-59/enpra-bridge:dev-latest
ENPRA_DEV_APP_CONTAINER_NAME=enpra-dev-bridge
ENPRA_DB_CONTAINER_NAME=enpra-postgres
ENPRA_NETWORK_NAME=enpra

# Public API: http(s)://enpra.ipstein.myds.me:7013
ENPRA_BIND_ADDR=0.0.0.0
ENPRA_HOST_PORT=7013
ENPRA_CONTAINER_PORT=8787

# Development API: https://dev-enpra-api.ipstein.myds.me (NAS port 7014)
ENPRA_DEV_HOST_PORT=7014
ENPRA_DEV_CONTAINER_PORT=8787

POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_CONTAINER_PORT=5432
